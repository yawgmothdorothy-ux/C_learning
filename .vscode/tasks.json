{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "编译当前 C 文件",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-lm",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译当前打开的单文件 C 练习。"
        },
        {
            "type": "cppbuild",
            "label": "编译特殊数字",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/Basics_基础练习/SpecialNumbers_特殊数字/rate.c",
                "-lm",
                "-o",
                "${workspaceFolder}/Basics_基础练习/SpecialNumbers_特殊数字/program"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Basics_基础练习/SpecialNumbers_特殊数字"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "编译最大子数组",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/DynamicProgramming_动态规划/MaxSubarray_最大子段和/MultiFile_多文件实现/main.c",
                "${workspaceFolder}/DynamicProgramming_动态规划/MaxSubarray_最大子段和/MultiFile_多文件实现/memory.c",
                "${workspaceFolder}/DynamicProgramming_动态规划/MaxSubarray_最大子段和/MultiFile_多文件实现/Max_subarray.c",
                "-o",
                "${workspaceFolder}/DynamicProgramming_动态规划/MaxSubarray_最大子段和/MultiFile_多文件实现/program"
            ],
            "options": {
                "cwd": "${workspaceFolder}/DynamicProgramming_动态规划/MaxSubarray_最大子段和/MultiFile_多文件实现"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译最大连续子数组项目。"
        },
        {
            "type": "cppbuild",
            "label": "编译学生成绩",
            "command": "/usr/bin/gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/StudentScores_学生成绩/SingleFile_单文件统计/main.c",
                "-o",
                "${workspaceFolder}/StudentScores_学生成绩/SingleFile_单文件统计/program"
            ],
            "options": {
                "cwd": "${workspaceFolder}/StudentScores_学生成绩/SingleFile_单文件统计"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译学生成绩项目。"
        },
        {
            "type": "cppbuild",
            "label": "编译班级成绩分析",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/StudentScores_学生成绩/ClassAnalysis_班级成绩分析/class_score.c",
                "${workspaceFolder}/StudentScores_学生成绩/ClassAnalysis_班级成绩分析/student_score.c",
                "-o",
                "${workspaceFolder}/StudentScores_学生成绩/ClassAnalysis_班级成绩分析/program"
            ],
            "options": {
                "cwd": "${workspaceFolder}/StudentScores_学生成绩/ClassAnalysis_班级成绩分析"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译班级成绩分析的两个源文件。"
        }
    ]
}
