{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "编译当前 C 文件",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-lm",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译当前打开的单文件 C 练习。"
        },
        {
            "type": "cppbuild",
            "label": "编译特殊数字",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/Alice_and_bob/rate.c",
                "-lm",
                "-o",
                "${workspaceFolder}/Alice_and_bob/program"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Alice_and_bob"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "编译最大子数组",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/week01_max_subarray/main.c",
                "${workspaceFolder}/week01_max_subarray/memory.c",
                "${workspaceFolder}/week01_max_subarray/Max_subarray.c",
                "-o",
                "${workspaceFolder}/week01_max_subarray/program"
            ],
            "options": {
                "cwd": "${workspaceFolder}/week01_max_subarray"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译最大连续子数组项目。"
        },
        {
            "type": "cppbuild",
            "label": "编译学生成绩",
            "command": "/usr/bin/gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/student_Score/main.c",
                "-o",
                "${workspaceFolder}/student_Score/program"
            ],
            "options": {
                "cwd": "${workspaceFolder}/student_Score"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译学生成绩项目。"
        }
    ]
}
